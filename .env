# =============================================================================
# Global configuration for the CephFS-for-Dovecot benchmark harness.
# Read automatically by docker-compose (variable substitution in compose file).
# =============================================================================

# --- Ceph image -------------------------------------------------------------
# Reef (v18) is the stable LTS line. This single image contains every Ceph
# binary we need (ceph-mon, ceph-mgr, ceph-osd, ceph-mds, ceph-volume, the
# `ceph` CLI). We hand-roll the bootstrap ourselves rather than use cephadm,
# because cephadm wants systemd+podman on real hosts and is awkward inside
# docker-compose.
CEPH_IMAGE=quay.io/ceph/ceph:v18

# --- Cluster identity -------------------------------------------------------
# Fixed cluster fsid so re-runs are reproducible. (A real cluster would use a
# random uuidgen value; we pin it so the monmap/keyrings are deterministic.)
CEPH_FSID=b1e9d9aa-0000-4000-8000-000000000001

# Ceph cluster network. We give every daemon a STATIC IP on this subnet so the
# monmap can be built ahead of time (Ceph monitors are addressed by IP, not
# DNS, in the initial monmap). See docker-compose.yml for the IP assignments.
CEPH_PUBLIC_SUBNET=172.28.0.0/16

# Monitor IPs (must match docker-compose.yml). mon_host in ceph.conf is built
# from these three.
MON1_IP=172.28.0.11
MON2_IP=172.28.0.12
MON3_IP=172.28.0.13

# --- Storage sizing ---------------------------------------------------------
# Size of each OSD's BlueStore block file (file-backed, vstart-style — no loop
# device needed). 4 OSDs => ~4x this much disk used at most.
OSD_SIZE_GB=10

# --- Replication / failure domain -------------------------------------------
# size=3 means 3 copies of every object. With failure domain = rack and 4
# racks, each PG places its 3 copies in 3 DISTINCT racks, leaving 1 spare rack
# so a single-OSD (== single-rack) loss can self-heal onto the spare.
POOL_SIZE=3
POOL_MIN_SIZE=2
FAILURE_DOMAIN=rack

# --- Dovecot test account ---------------------------------------------------
# imaptest authenticates as these. We use a static-password file auth (see
# dovecot/conf.d/10-auth.conf) so there is no external user DB to run.
MAIL_DOMAIN=bench.local
MAIL_TEST_USER=user
MAIL_TEST_PASS=pass
# Number of distinct test accounts (user0001 .. userNNNN) for the imaptest
# userfile. Spreading load across many mailboxes avoids single-mailbox lock
# contention and exercises MDS metadata distribution.
MAIL_USER_COUNT=100

# --- Mail format under test -------------------------------------------------
# Toggled by scripts between runs. One of: mdbox | maildir
# (mdbox = Dovecot's recommended packed format; maildir = one-file-per-message,
#  metadata/MDS-bound worst case). Both are benchmarked.
MAIL_FORMAT=mdbox
